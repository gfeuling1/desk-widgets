{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desk-widgets",
  "version": "1.0.0",
  "identifier": "com.gideonfeuling.deskwidgets",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
  {
    "label": "main",
    "title": "Desk Widgets",
    "transparent": true,
    "decorations": false,
    "shadow": false,
    "maximized": true,
    "resizable": false,
    "skipTaskbar": true,
    "alwaysOnBottom": true
  }
  ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
